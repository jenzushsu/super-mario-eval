# Copy to .env and replace these placeholders locally. Never commit real keys.
# Load with: uv run --frozen --env-file .env mario-eval
TYPESAFE_API_KEY="replace_with_your_typesafe_key"
ZOOM_API_KEY="replace_with_your_zoom_decisions_key"

# Released Zoom API: bearer access token (takes precedence over legacy key above).
# Requires aiservices:write:decide:admin and applicable entitlement.
# ZOOM_ACCESS_TOKEN="replace_with_your_zoom_access_token"
